# Copy this file to ".env" (same folder) and fill in the two values from
# https://developer.yahoo.com/apps/  ->  your app.
#
# .env is git-ignored. Do not paste these values anywhere else.

YAHOO_CLIENT_ID=paste_your_Client_ID_here
YAHOO_CLIENT_SECRET=paste_your_Client_Secret_here

# Must match the Redirect URI you entered when creating the Yahoo app, exactly.
YAHOO_REDIRECT_URI=http://localhost:8000/callback

# Optional
PORT=8000
